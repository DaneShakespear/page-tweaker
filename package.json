{
  "name": "page-tweaker",
  "version": "0.4.0-dev.1",
  "description": "Open any page, show AI what should change, and drag back one complete brief.",
  "author": "Dane Shakespear",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaneShakespear/page-tweaker.git"
  },
  "main": "src/main.cjs",
  "bin": {
    "page-tweaker": "bin/page-tweaker.cjs"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:mac": "electron-builder --mac dmg",
    "dmg:background": "swift scripts/dmg-background.swift",
    "smoke:ui": "node scripts/smoke-ui.cjs"
  },
  "build": {
    "appId": "com.kre8works.pagetweaker",
    "productName": "AI PagePolish by PageTweaker",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "src/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "webloc",
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "svg"
        ],
        "name": "Web page or image",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "AI PagePolish by PageTweaker URL handler",
        "schemes": [
          "page-tweaker",
          "http",
          "https"
        ]
      }
    ],
    "dmg": {
      "background": "assets/dmg-background.png",
      "window": { "width": 760, "height": 740 },
      "iconSize": 80,
      "iconTextSize": 13,
      "contents": [
        { "x": 190, "y": 215, "type": "file" },
        { "x": 570, "y": 215, "type": "link", "path": "/Applications" },
        { "x": 650, "y": 60, "type": "file", "path": "assets/Install Help.txt" }
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/PageTweaker.icns",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
